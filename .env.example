# High-entropy bearer token used only by the trusted identity collector.
IDENTITY_INGEST_TOKEN=

# High-entropy bearer token used by the direct-source collectors.
DIRECT_SOURCE_INGEST_TOKEN=
DIRECT_SOURCE_INGEST_URL=https://agenticpaymentsindex.org/api/internal/direct-source-ingest

# Coinbase CDP Client API key for direct Base SQL queries.
# Create this in the CDP portal. Never commit the real value.
CDP_CLIENT_API_KEY=

# Recommended for backfill: a dedicated Tempo archive endpoint from an official
# infrastructure partner. The public RPC is the code default but is rate-limited.
TEMPO_RPC_URL=https://rpc.tempo.xyz
